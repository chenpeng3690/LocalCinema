<?xml version="1.0" encoding="utf-8"?>
<!--
  通知栏小图标。

  必须是单色的：系统会把它整体染色（通知栏白色、部分 ROM 会按强调色 tint），
  所以这里只有白色 + 镂空，不含任何彩色或多层灰度。

  形状：实心圆挖掉一个播放三角（evenOdd），小尺寸下也能认出来。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M10.3,7.4 L17.4,12 L10.3,16.6 Z" />
</vector>
